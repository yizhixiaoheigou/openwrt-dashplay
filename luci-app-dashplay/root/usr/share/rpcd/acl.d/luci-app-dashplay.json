{
  "luci-app-dashplay": {
    "description": "Grant access to DashPlay settings",
    "read": {
      "ubus": {
        "service": [
          "list"
        ],
        "file": [
          "read"
        ]
      },
      "uci": [
        "dashplay",
        "wireless"
      ],
      "file": {
        "/var/run/dashplay/network-status.json": [
          "read"
        ]
      }
    },
    "write": {
      "uci": [
        "dashplay"
      ]
    }
  }
}
