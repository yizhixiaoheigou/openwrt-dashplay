config dashplay 'main'
	option enabled '1'
	# Wi-Fi handed to the iPhone: a wifi-iface section of /etc/config/wireless, or 'auto' (the first
	# access point that is up, 5 GHz first; then a client network).
	option wifi 'auto'
	# wifi 'external': hand the iPhone another router's Wi-Fi instead (a travel router with better radios that
	# gets its uplink from this router over USB or a cable, as an access point bridged into external_network,
	# so phones and the head unit get their addresses here). Give that Wi-Fi a fixed channel and enter it.
	# Security: wpa2 (also for WPA2/WPA3 mixed), wpa3 or open.
	option external_ssid ''
	option external_key ''
	option external_security 'wpa2'
	option external_channel ''
	option external_network 'lan'
	# DashPlay settings page (iPhones, certificate, diagnostics); LuCI keeps port 80.
	option settings_port '18080'
	# Name in the viewer address https://<name>:<viewer_port>/ (kept pointing at the router by DashPlay).
	option name 'dashplay.lan'
	# The CarPlay page's HTTPS port. Empty is 18443, or the port an older install saved in
	# state/receiver/config.json (adopted once); changing it takes about a minute and interrupts CarPlay.
	# It must differ from settings_port, 80, 443 and 7000. The LuCI writes it; the supervisor keeps it current.
	option viewer_port ''
	# Seconds without a viewer page before wireless CarPlay ends, so the iPhone stops sending its screen
	# (it runs warm near a router left on); a page opened later invites it again (~7 s). 0: never ends.
	option idle_release '300'
	# The name also answers with the router's own public IPv6 address, for car browsers that refuse a private
	# one (the router answers that address itself; the picture stays on the Wi-Fi): 0 no, 1 beside the LAN
	# address, 2 instead of it.
	option public_ipv6 '0'
	# For car browsers that refuse every private address, by name too (Tesla): 1 moves the LAN of the router's
	# own Wi-Fi to 100.96.0.1/24 (not a private range); 0 puts the previous address back.
	option shared_lan '0'
	# For any car whose own Bluetooth is paired with the iPhone. car_music 1: the music goes over the car's
	# Bluetooth (steering wheel, media card and volume are the car's own; the page plays prompts louder).
	# car_voice 1: calls and Siri too (the CarPlay page offers no microphone).
	option car_music '0'
	option car_voice '0'
	# 1: the two switches above are the owner's choice. The package sets it once on upgrade; before 2026-10-28
	# Tesla mode forced both on, so an existing Tesla config migrates to both on. Not shown in LuCI.
	option car_audio_split '1'
	# Tesla mode: shared_lan, the Tesla browser's fullscreen, and both switches above turned on when Tesla mode is
	# enabled; afterwards they stay the owner's choice.
	option tesla_mode '0'
	# The LAN stays online for the whole Tesla mode; only the upstream switches. auto: recommended;
	# 1: always answer (even with upstream); 0: real network only (the Tesla will not join without it).
	option answer_tesla_checks 'auto'
	# For car browsers that refuse DashPlay's own certificate with no way past the warning: a DuckDNS
	# sub-domain and its token (duckdns.org). The name becomes <sub-domain>.duckdns.org, pointed at the router,
	# with a Let's Encrypt certificate the router obtains and renews itself (DNS-01, no open port).
	option duckdns_domain ''
	option duckdns_token ''
	# Online update (update.py): check for a new release once a day and show it in LuCI and on the settings page; an
	# update is installed only when someone clicks it. update_mirror: URL prefixes tried after GitHub ('none': GitHub
	# only; empty: the built-in one). Releases are signed, so a mirror cannot alter what is installed.
	option update_check '1'
	option update_mirror ''
