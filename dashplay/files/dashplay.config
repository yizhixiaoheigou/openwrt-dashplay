config dashplay 'main'
	option enabled '1'
	# Wi-Fi handed to the iPhone: a wifi-iface section of /etc/config/wireless, or 'auto' (the first
	# access point that is up, 5 GHz first; then a client network).
	option wifi 'auto'
	# DashPlay settings page (iPhones, certificate, diagnostics); LuCI keeps port 80.
	option settings_port '18080'
	# Name in the viewer address https://<name>:18443/ (kept pointing at the router by DashPlay).
	option name 'dashplay.lan'
