config dashplay 'main'
	option enabled '1'
	# Wi-Fi handed to the iPhone: a wifi-iface section of /etc/config/wireless, or 'auto' (the first
	# access point that is up, 5 GHz first; then a client network).
	option wifi 'auto'
	# DashPlay settings page (iPhones, certificate, diagnostics); LuCI keeps port 80.
	option settings_port '18080'
	# Name in the viewer address https://<name>:18443/ (kept pointing at the router by DashPlay).
	option name 'dashplay.lan'
	# Seconds without a viewer page before wireless CarPlay ends, so the iPhone stops sending its screen
	# (it runs warm near a router left on); a page opened later invites it again (~7 s). 0: never ends.
	option idle_release '300'
	# The name also answers with the router's own public IPv6 address, for car browsers that refuse a private
	# one (the router answers that address itself; the picture stays on the Wi-Fi): 0 no, 1 beside the LAN
	# address, 2 instead of it.
	option public_ipv6 '0'
	# For car browsers that refuse every private address, by name too (Tesla): 1 moves the LAN of the router's
	# own Wi-Fi to 100.96.0.1/24 (not a private range); 0 puts the previous address back.
	option shared_lan '0'
	# For any car whose own Bluetooth is paired with the iPhone. car_music 1: the music goes over the car's
	# Bluetooth (steering wheel, media card and volume are the car's own; the page plays prompts louder).
	# car_voice 1: calls and Siri too (the CarPlay page offers no microphone).
	option car_music '0'
	option car_voice '0'
	# Tesla mode: shared_lan, car_music, car_voice and the Tesla browser's fullscreen.
	option tesla_mode '0'
	# For car browsers that refuse DashPlay's own certificate with no way past the warning: a DuckDNS
	# sub-domain and its token (duckdns.org). The name becomes <sub-domain>.duckdns.org, pointed at the router,
	# with a Let's Encrypt certificate the router obtains and renews itself (DNS-01, no open port).
	option duckdns_domain ''
	option duckdns_token ''
